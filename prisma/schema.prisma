// KuberaNow — full dynamic data model
// Database: SQLite for local dev. To switch to PostgreSQL (Supabase/Neon):
//   1. Change provider below to "postgresql"
//   2. Re-add @db.Decimal / @db.Text annotations for strict column types
//   3. Optionally re-enable enums (search for the "SQLite: enum as String" notes)
//   4. Run `npx prisma migrate dev` against your new DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// SQLite has no enums — we store them as String and constrain in app code.
// Role values: "admin" | "editor" | "reader"
// Status values: "draft" | "published"
// Market category values: "index" | "stock" | "mutual_fund" | "ipo" | "commodity" | "crypto"
// Calc type values: "sip" | "fd" | "emi" | "tax" | "swp"

// ============ Auth.js standard tables ============

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  // Legacy role string kept for backward compat with the JWT/proxy during the
  // migration. The source of truth is now the roleId relation below; this
  // column is derived from it at login.
  role          String   @default("reader")
  roleId        String?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roleRelation       Role?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  accounts           Account[]
  sessions           Session[]
  applications       Application[]
  savedCalculations  SavedCalculation[]
}

// A named bundle of permissions that can be assigned to many users.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  // System roles (Admin, Editor, Reader) are seeded and cannot be deleted.
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       User[]
}

// Single permission definition (e.g. "articles.edit"). The catalog is fixed
// in code (src/lib/permissions.ts) and seeded here; admins toggle which
// roles hold which permissions via RolePermission rows.
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // "articles.edit"
  label       String   // "Edit articles"
  description String?
  category    String   // "Articles" (for grouping in the matrix UI)
  roles       RolePermission[]

  @@index([category])
}

// Join table: which roles have which permissions.
model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ Content ============

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique // "india", "personal-finance", ...
  name        String    // "Economy"
  description String?
  sortOrder   Int       @default(0)
  articles    Article[]
}

model Article {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  excerpt    String
  body       String
  imageUrl   String?
  categoryId String
  author     String
  status     String   @default("draft") // "draft" | "published"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, status])
}

model Job {
  id          String   @id @default(cuid())
  title       String
  description String
  experience  String
  salary      String
  location    String
  type        String // "Full-time"
  mode        String // "On-site"
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]
}

model Application {
  id            String   @id @default(cuid())
  jobId         String
  userId        String?
  name          String
  email         String
  phone         String?
  coverLetter   String?
  read          Boolean  @default(false)
  readAt        DateTime?
  resumePath    String?  // relative path under public/, e.g. /uploads/applications/<id>/resume.pdf
  resumeName    String?  // original filename
  resumeSize    Int?     // bytes
  resumeMime    String?  // e.g. application/pdf
  createdAt     DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([read, createdAt])
  @@index([jobId, createdAt])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

// ============ Market data ============

model MarketQuote {
  id           String  @id @default(cuid())
  category     String  // "index" | "stock" | "mutual_fund" | "ipo" | "commodity" | "crypto"
  symbol       String
  name         String
  price        Float
  change       Float
  volume       String?
  dayRangeLow  Float?
  dayRangeHigh Float?
  cagr3y       Float?
  lotSize      String?
  unit         String?
  sortOrder    Int     @default(0)
  updatedAt    DateTime @updatedAt

  @@index([category, sortOrder])
}

// ============ CMS pages + site settings ============

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique // "about-us", "advertise", "disclaimer", "privacy-policy", "terms-of-use"
  title     String
  subtitle  String?
  // JSON: array of { type: "heading"|"paragraph"|"list", value, level?, items? }
  sections  String // JSON-encoded (SQLite has no native Json type via Prisma)
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id        String   @id @default("singleton")
  // JSON-encoded: { emails, phones, address, grievanceOfficer, socials }
  data      String
  updatedAt DateTime @updatedAt
}

// ============ User-generated content ============

model SavedCalculation {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "sip" | "fd" | "emi" | "tax" | "swp"
  // JSON snapshots of inputs and computed result
  inputs    String
  result    String
  label     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ============ Live streaming ============
//
// One `LiveStream` row tracks the persistent state of the live channel
// (title, RTMP ingest URL, HLS playback URL, OBS connection). One optional
// `LiveStreamSession` row per "go-live" cycle records the start/end time and
// peak viewer count for analytics.

model LiveStream {
  id              String   @id @default("singleton")
  title           String   @default("KuberaNow Live")
  description     String?
  status          String   @default("offline") // "offline" | "live" | "paused" | "error"
  startedAt       DateTime?
  endedAt         DateTime?
  // OBS WebSocket (v5) connection
  obsHost         String?  // e.g. "127.0.0.1"
  obsPort         Int?     // default 4455
  obsPassword     String?  // optional
  obsConnected    Boolean  @default(false)
  obsScene        String?  // current scene name from OBS
  // CDN / streaming provider
  rtmpUrl         String?  // OBS pushes the stream here
  rtmpKey         String?  // stream key (kept private — only shown once)
  hlsUrl          String?  // public playback URL (HLS .m3u8) — served by the CDN
  // Viewer tracking (approximate, sliding 5-minute window)
  peakViewers     Int      @default(0)
  totalViews      Int      @default(0)
  // Recording
  recordingEnabled Boolean @default(false)
  recordingUrl     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LiveStreamSession {
  id            String   @id @default(cuid())
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  title         String
  peakViewers   Int      @default(0)
  totalViews    Int      @default(0)
  recordingUrl  String?
}

// Per-viewer heartbeat (TTL-cleansed by the viewer-count poller)
model LiveStreamViewer {
  id         String   @id @default(cuid())
  sessionId  String   // anonymous viewer id (cookie)
  lastSeen   DateTime @default(now())
  userAgent  String?

  @@index([lastSeen])
}
